{
  "name": "@codori/webxr",
  "version": "0.14.3",
  "private": false,
  "description": "Immersive WebXR voice coding workspace for Codori.",
  "type": "module",
  "exports": {
    ".": "./dist/index.html"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/comfuture/codori.git",
    "directory": "packages/webxr"
  },
  "homepage": "https://github.com/comfuture/codori#immersive-webxr",
  "bugs": {
    "url": "https://github.com/comfuture/codori/issues"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "keywords": [
    "codori",
    "codex",
    "webxr",
    "virtual-reality",
    "threejs"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "dev": "vite",
    "lint": "eslint src test vite.config.ts --ext .ts",
    "render:sfx-previews": "node scripts/render-sound-previews.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@codori/client": "workspace:*",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@types/three": "0.185.4",
    "@types/webxr": "^0.5.24",
    "vite": "^8.2.1"
  }
}
