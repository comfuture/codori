{
  "name": "@codori/cli",
  "version": "0.13.6",
  "private": false,
  "description": "Codori command-line interface for serving projects and managing the background service.",
  "type": "module",
  "bin": {
    "codori": "dist/cli.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/comfuture/codori.git",
