  },
  "homepage": "https://github.com/comfuture/codori#readme",
  "bugs": {
    "url": "https://github.com/comfuture/codori/issues"
  },
  "keywords": [
    "codori",
    "codex",
    "cli",
    "remote-coding"
  ],
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "lint": "eslint src --ext .ts",
