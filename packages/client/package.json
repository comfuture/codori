{
  "name": "@codori/client",
  "version": "0.11.0",
  "private": false,
  "description": "Codori Nuxt dashboard for project browsing, Codex chat, and thread resume.",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/comfuture/codori.git",
    "directory": "packages/client"
  },
  "homepage": "https://github.com/comfuture/codori#readme",
  "bugs": {
    "url": "https://github.com/comfuture/codori/issues"
  },
  "exports": {
    ".": "./nuxt.config.ts",
    "./package.json": "./package.json",
    "./shared/codex-rpc": "./shared/codex-rpc.ts",
    "./shared/codex-chat": "./shared/codex-chat.ts",
    "./shared/realtime": "./shared/realtime.ts",
    "./shared/realtime-transcript": "./shared/realtime-transcript.ts",
    "./shared/background-terminals": "./shared/background-terminals.ts",
    "./shared/tool-items": "./shared/tool-items.ts",
    "./shared/ansi-output": "./shared/ansi-output.ts",
    "./shared/workspace": "./shared/workspace.ts",
    "./shared/generated/codex-app-server": "./shared/generated/codex-app-server/index.ts",
    "./shared/generated/codex-app-server/v2": "./shared/generated/codex-app-server/v2/index.ts",
    "./shared/*": "./shared/*.ts"
  },
  "keywords": [
    "codori",
    "codex",
    "nuxt",
    "dashboard",
    "chat"
  ],
  "files": [
    "app",
    "public",
    "server",
    "shared",
    "nuxt.config.ts",
    "README.md"
  ],
  "scripts": {
    "build": "nuxt generate",
    "dev": "nuxt dev",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run"
  },
  "dependencies": {
    "@comark/vue": "^0.3.1",
    "@iconify-json/hugeicons": "^1.2.31",
    "@iconify-json/lucide": "^1.2.105",
    "@nuxt/ui": "^4.7.1",
    "@vueuse/core": "14.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-fonts": "0.1.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "beautiful-mermaid": "^1.1.3",
    "katex": "^0.16.45",
    "nuxt": "^4.4.4",
    "ofetch": "^1.5.1",
    "shiki": "^4.0.2",
    "tailwindcss": "^4.2.4",
    "vue": "^3.5.33",
    "vue-router": "^5.0.6"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/test-utils": "^2.4.10",
    "jsdom": "^29.1.1",
    "vue-tsc": "3.3.7"
  }
}
