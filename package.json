{
  "name": "codori-workspace",
  "private": true,
  "version": "0.12.1",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build": "pnpm --filter @codori/client build && pnpm --filter @codori/webxr build && pnpm --filter @codori/server build && pnpm --filter @codori/cli build",
    "dev": "pnpm --filter @codori/client dev",
    "dev:webxr": "pnpm --filter @codori/webxr dev",
    "generate:codex-types": "node ./scripts/generate-codex-types.mjs",
    "run:local": "pnpm build && node packages/cli/dist/cli.js start --root .. --host 127.0.0.1 --experimental-realtime-voice",
    "lint": "pnpm -r --if-present lint",
    "release:publish": "node ./scripts/publish-release.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test"
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "@xterm/addon-web-fonts>@xterm/xterm": "6.0.x"
      }
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.0",
    "@types/ws": "^8.18.1",
    "@vue/language-core": "^3.2.7",
    "eslint": "^10.3.0",
    "eslint-plugin-vue": "^10.9.0",
    "globals": "^17.6.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.1",
    "vitest": "^4.1.5",
    "vue-eslint-parser": "^10.4.0"
  }
}
